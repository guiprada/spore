#!/bin/sh
# spore — declarative, installation-less configuration for Alpine Linux.
#
# A spore is a small readable bundle; a machine is what a blank Alpine becomes
# when it germinates one. There is no install verb, only `apply`: converging to a
# declared state does not care where it started.

set -eu

SPORE_SELF=$0
# Overridable so the tool can be installed away from its source tree — the seed
# apkovl puts it at /usr/local/lib/spore with a wrapper on PATH.
if [ -z "${SPORE_PREFIX:-}" ]; then
    SPORE_PREFIX=$(CDPATH='' cd -- "$(dirname -- "$SPORE_SELF")/.." && pwd)
fi
SPORE_LIB=$SPORE_PREFIX/lib
SPORE_MODULES=$SPORE_PREFIX/modules

for _f in core conf facts plan render blob secret module exec_live exec_print \
          persist seed apkfetch bootstrap wizard media try inspect; do
    . "$SPORE_LIB/$_f.sh"
done

trap spore_cleanup EXIT INT TERM

usage() {
    cat <<'USAGE'
spore — declarative configuration for Alpine Linux

usage: spore [options] <command>

commands:
  setup [DIR]       guided: asks, then writes a machine directory
  media DEV ISO     partition and write a boot medium (ERASES DEV)
  try DEV [write] [bootloader] [disk|disk=PATH] [mem=MB]
                    boot it in a VM. The kernel is taken off the medium and
                    booted directly, so the console can be captured; add
                    `bootloader` to go through the image's own instead,
                    `disk` to attach a second stick for STORAGE_AUTO to find,
                    and `mem=` to raise the guest's RAM — a diskless root is
                    half of it, which a desktop does not fit in at the 2048
                    default
  inspect DEV       what is on a medium, and what its last boot logged
  new NAME [DIR]    the same directory, without the questions
  install DIR DEV|DATA [BOOT]
                    write a machine onto a mounted data partition; naming the
                    boot partition too puts the seed where the initramfs can
                    certainly read it
  retire DEV        after the machine has committed, set its bootstrap seeds
                    aside so the committed overlay is the only apkovl left and
                    the initramfs cannot pick the wrong one

  init [DIR]     scaffold a new spore
  plan           show the action list this spore produces (no changes)
  apply          converge this host to the spore
  status         per-module: declared vs actual
  diff           show drift under paths the spore owns
  persist        make the current state survive a reboot
  doctor         host facts and sanity checks
  modules [add|rm NAME...]
                 list available modules, or turn one on or off
  seed [FILE]    build a generic bootstrap apkovl (needs no spore)
  secrets        list the secrets this spore carries
  seal NAME [F]  encrypt F (or stdin) into the spore as NAME
  passwd USER    ask for a password, hash it, and seal it for USER
  set MOD K V    set a module setting, checked (e.g. set net NET_DNS 1.1.1.1)

options:
  -s, --spore DIR   the spore to use (default: $SPORE_DIR, ./spore,
                    or /var/lib/spore/spore)
  -r, --root DIR    apply under DIR instead of / (synthetic root)
  -n, --dry-run     announce actions, change nothing
  -i, --identity F  age identity used to decrypt this spore's secrets
      --persist     with `apply`: commit afterwards
  -h, --help        this
  -V, --version     version
USAGE
}

SPORE_DO_PERSIST=0
SPORE_CMD=''

# Options are taken from anywhere on the line, before the command or after it.
# This loop used to stop at the first word that was not an option — so
# `spore -s DIR apply --persist`, which is exactly what the seed runs, set the
# command, left `--persist` unread, and said nothing about it. The machine then
# converged perfectly, persisted nothing, and reported success for both. An
# option that is silently ignored is worse than one that is rejected.
#
# Everything that is not an option is rotated to the back, so what remains when
# the count runs out is the positional arguments in their original order.
sp_left=$#
while [ "$sp_left" -gt 0 ]; do
    sp_left=$((sp_left - 1))
    case $1 in
        -s|--spore)   [ $# -ge 2 ] || die "--spore needs a directory"
                      SPORE_DIR=$2; shift 2; sp_left=$((sp_left - 1)) ;;
        -r|--root)    [ $# -ge 2 ] || die "--root needs a directory"
                      SPORE_ROOT=$2; shift 2; sp_left=$((sp_left - 1)) ;;
        -n|--dry-run) SPORE_DRYRUN=1; shift ;;
        -i|--identity) [ $# -ge 2 ] || die "--identity needs a file"
                      SPORE_IDENTITY=$2; shift 2; sp_left=$((sp_left - 1)) ;;
        --persist)    SPORE_DO_PERSIST=1; shift ;;
        -h|--help)    usage; exit 0 ;;
        -V|--version) printf 'spore %s\n' "$SPORE_VERSION"; exit 0 ;;
        --)           shift
                      while [ "$sp_left" -gt 0 ]; do
                          set -- "$@" "$1"; shift
                          sp_left=$((sp_left - 1))
                      done ;;
        -*)           die "unknown option: $1" ;;
        *)            set -- "$@" "$1"; shift ;;
    esac
done
if [ $# -gt 0 ]; then
    SPORE_CMD=$1
    shift
fi

[ -n "$SPORE_CMD" ] || { usage; exit 2; }

spore_locate() {
    if [ -n "${SPORE_DIR:-}" ]; then :
    elif [ -d ./spore ] && [ -f ./spore/spore.conf ]; then SPORE_DIR=./spore
    elif [ -f /var/lib/spore/spore/spore.conf ]; then SPORE_DIR=/var/lib/spore/spore
    else die "no spore found (use --spore DIR or set SPORE_DIR)"
    fi
}

spore_load() {
    spore_locate
    [ -d "$SPORE_DIR" ] || die "spore not found: $SPORE_DIR"
    [ -f "$SPORE_DIR/spore.conf" ] || die "not a spore (no spore.conf): $SPORE_DIR"
    SPORE_DIR=$(CDPATH='' cd -- "$SPORE_DIR" && pwd)

    sl_fmt=$(conf_get "$SPORE_DIR/spore.conf" FORMAT 1)
    [ "$sl_fmt" = 1 ] || die "spore FORMAT=$sl_fmt is not supported by spore $SPORE_VERSION"

    SPORE_HOST=$(conf_get "$SPORE_DIR/spore.conf" HOST "$(hostname 2>/dev/null || echo unknown)")
    SPORE_MODULE_LIST=$(conf_get "$SPORE_DIR/spore.conf" MODULES '')
    [ -n "$SPORE_MODULE_LIST" ] || die "spore.conf declares no MODULES"
}

prepare() { spore_load; spore_workspace; plan_build; }

report_skipped() {
    [ -s "$SPORE_WORK/skipped" ] || return 0
    while IFS="$SPORE_TAB" read -r rs_m rs_r; do
        skipped "$rs_m: n/a here ($(requirement_reason "$rs_r"))"
    done < "$SPORE_WORK/skipped"
}

# --- commands ----------------------------------------------------------------

cmd_plan() {
    prepare
    printf '%s — %s actions\n\n' "$SPORE_HOST" "$(plan_count)"
    exec_print
    report_skipped
    plan_notes_show
}

cmd_apply() {
    prepare
    if [ "$SPORE_DRYRUN" = 1 ]; then
        printf 'dry run — %s would be converged to %s\n\n' "$SPORE_HOST" "$SPORE_DIR"
    else
        printf 'applying %s\n\n' "$SPORE_DIR"
    fi

    exec_plan
    report_skipped
    plan_notes_show

    printf '\n  %s changed, %s already correct\n' "$SPORE_N_CHANGED" "$SPORE_N_UNCHANGED" >&2
    report_deferred
    report_offline_boot
    report_ram_root
    report_ports

    if [ "$SPORE_DO_PERSIST" = 1 ]; then
        printf '\n'; persist_commit
    elif [ "$(persist_backend)" = lbu ] && [ "$SPORE_DRYRUN" != 1 ]; then
        warn "this host is diskless: nothing here survives a reboot until you run
         \`spore persist\` (or apply with --persist)."
    fi
    persist_warnings
}

cmd_status() {
    prepare
    printf '%s  (%s)\n\n' "$SPORE_HOST" "$SPORE_DIR"
    for cs_m in $SPORE_MODULE_LIST; do
        if module_is_skipped "$cs_m"; then
            printf '  %-10s %sn/a (%s)%s\n' "$cs_m" "$_c_yellow" \
                "$(requirement_reason "$(module_skip_reason "$cs_m")")" "$_c_reset"
            continue
        fi
        cs_drift=0 cs_total=0
        plan_lines_of_module "$cs_m" > "$SPORE_WORK/mod.tsv"
        while IFS="$SPORE_TAB" read -r cs_mod cs_act g1 g2 g3 g4 g5 g6; do
            case $cs_act in
                file)
                    cs_total=$((cs_total + 1))
                    cs_dst=$(rootpath "$g1")
                    if [ ! -f "$cs_dst" ] || [ "$(sha256_file "$cs_dst")" != "$g4" ]; then
                        cs_drift=$((cs_drift + 1))
                    fi ;;
                secret)
                    cs_total=$((cs_total + 1))
                    cs_dst=$(rootpath "$g1")
                    if [ ! -f "$cs_dst" ]; then cs_drift=$((cs_drift + 1)); fi ;;
                svc)
                    cs_total=$((cs_total + 1))
                    cs_link=$(rootpath "/etc/runlevels/$g2/$g1")
                    if [ "$g3" = on ]; then
                        [ -e "$cs_link" ] || [ -L "$cs_link" ] || cs_drift=$((cs_drift + 1))
                    else
                        if [ -e "$cs_link" ] || [ -L "$cs_link" ]; then cs_drift=$((cs_drift + 1)); fi
                    fi ;;
            esac
        done < "$SPORE_WORK/mod.tsv"

        if [ "$cs_drift" = 0 ]; then
            printf '  %-10s %sok%s  (%s checks)\n' "$cs_m" "$_c_green" "$_c_reset" "$cs_total"
        else
            printf '  %-10s %s%s of %s differ%s\n' "$cs_m" "$_c_red" "$cs_drift" "$cs_total" "$_c_reset"
        fi

        # Optional per-module detail the plan cannot know (is a volume mounted?).
        if command -v "${cs_m}_status_extra" >/dev/null 2>&1; then
            SPORE_MOD=$cs_m
            "${cs_m}_status_extra" 2>/dev/null | sed 's/^/               /'
        fi
    done
    plan_notes_show
}

cmd_diff() {
    prepare
    cd_any=0
    # Secrets are compared, never displayed: a diff that prints a decrypted
    # private key defeats the point of carrying it encrypted.
    plan_lines_of_type secret > "$SPORE_WORK/secrets.tsv"
    while IFS="$SPORE_TAB" read -r cs2_mod cs2_act k1 k2 k3 k4; do
        [ -n "$k1" ] || continue
        cd_any=1
        cs2_dst=$(rootpath "$k1")
        if ! secret_can_decrypt; then
            printf '%s??? %s (encrypted; no identity available to compare)%s\n' \
                "$_c_yellow" "$k1" "$_c_reset"
        elif [ ! -f "$cs2_dst" ]; then
            printf '%s+++ %s (absent; would be written from an encrypted secret)%s\n' \
                "$_c_green" "$k1" "$_c_reset"
        else
            (umask 077; secret_render "$(content_path "$k4")" > "$SPORE_WORK/cmp.out")
            if [ "$(sha256_file "$cs2_dst")" = "$(sha256_file "$SPORE_WORK/cmp.out")" ]; then
                cd_any=0
            else
                printf '%s!!! %s (differs from the spore; content withheld)%s\n' \
                    "$_c_yellow" "$k1" "$_c_reset"
            fi
            rm -f "$SPORE_WORK/cmp.out"
        fi
    done < "$SPORE_WORK/secrets.tsv"

    plan_lines_of_type file > "$SPORE_WORK/files.tsv"
    while IFS="$SPORE_TAB" read -r cd_mod cd_act h1 h2 h3 h4; do
        cd_dst=$(rootpath "$h1")
        if [ ! -f "$cd_dst" ]; then
            printf '\n%s+++ %s (absent, would be created by %s)%s\n' "$_c_green" "$h1" "$cd_mod" "$_c_reset"
            cd_any=1
            continue
        fi
        if [ "$(sha256_file "$cd_dst")" != "$h4" ]; then
            printf '\n%s--- %s (on host)\n+++ %s (from spore, %s)%s\n' \
                "$_c_yellow" "$h1" "$h1" "$cd_mod" "$_c_reset"
            diff -u "$cd_dst" "$(content_path "$h4")" || true
            cd_any=1
        fi
    done < "$SPORE_WORK/files.tsv"
    [ "$cd_any" = 0 ] && printf 'no drift under paths this spore owns\n'
    return 0
}

cmd_persist() {
    prepare
    persist_commit
    persist_warnings
}

cmd_doctor() {
    printf 'host facts\n\n'
    facts_show | sed 's/^/  /'
    printf '\n'
    if [ -n "${SPORE_DIR:-}" ] || [ -f ./spore/spore.conf ] || [ -f /var/lib/spore/spore/spore.conf ]; then
        prepare
        printf 'spore\n\n'
        printf '  host      %s\n  modules   %s\n  actions   %s\n' \
            "$SPORE_HOST" "$(printf '%s' "$SPORE_MODULE_LIST" | tr '\n' ' ')" "$(plan_count)"
        printf '\n'
        report_skipped
        plan_notes_show
    else
        say 'no spore located — showing host facts only'
    fi
    ca_warnings
    lbu_warnings
    persist_warnings
}

cmd_seed() {
    spore_workspace
    cs_out=${1:-spore-seed.apkovl.tar.gz}
    case $cs_out in
        */*) : ;;
        *) cs_out=$PWD/$cs_out ;;
    esac
    seed_build "$cs_out"
    printf 'wrote %s (%s bytes)\n\n' "$cs_out" "$(wc -c < "$cs_out" | tr -d ' ')"
    cat <<'NEXT'
It carries no configuration — put both of these on the data partition:

    <data>/spore-seed.apkovl.tar.gz     this file, generic, never edited
    <data>/spore/                       a spore directory, plain text, yours

Start from examples/example.spore, edit it, and boot. The first boot finds the
spore, applies it, and commits. Progress goes to /var/log/spore-seed.log.
NEXT
}

cmd_secrets() {
    spore_load
    if [ ! -d "$SPORE_DIR/secrets" ]; then
        printf 'this spore carries no secrets\n'; return 0
    fi
    printf 'identity  %s%s\n' "$(secret_identity)" \
        "$([ -f "$(secret_identity)" ] && printf '' || printf '  (not present here)')"
    printf 'recipients %s\n\n' \
        "$([ -f "$SPORE_DIR/secrets/recipients" ] && printf 'secrets/recipients' || printf '(none — cannot seal)')"
    for cse_s in $(secret_list); do
        printf '  %s\n' "$cse_s"
    done
}

cmd_seal() {
    [ $# -ge 1 ] || die "usage: spore seal NAME [FILE]"
    spore_load
    cse_name=$1
    cse_src=${2:--}
    cse_rcpt=$SPORE_DIR/secrets/recipients
    [ -f "$cse_rcpt" ] || die "no secrets/recipients in this spore — add age public keys there first"
    command -v "$SPORE_AGE" >/dev/null 2>&1 || die "age is not installed"
    mkdir -p "$SPORE_DIR/secrets"
    case $cse_name in
        *.password)
            if [ "$cse_src" = - ]; then cse_val=$(cat); else cse_val=$(cat "$cse_src"); fi
            seal_password_check "$cse_name" "$cse_val"
            printf '%s\n' "$cse_val" |
                "$SPORE_AGE" --encrypt -R "$cse_rcpt" \
                    -o "$SPORE_DIR/secrets/$cse_name.age"
            printf 'sealed secrets/%s.age\n' "$cse_name"
            return 0 ;;
    esac
    if [ "$cse_src" = - ]; then
        "$SPORE_AGE" --encrypt -R "$cse_rcpt" -o "$SPORE_DIR/secrets/$cse_name.age"
    else
        [ -f "$cse_src" ] || die "no such file: $cse_src"
        "$SPORE_AGE" --encrypt -R "$cse_rcpt" -o "$SPORE_DIR/secrets/$cse_name.age" "$cse_src"
    fi
    printf 'sealed secrets/%s.age\n' "$cse_name"
}

# A *.password secret is a hash, not a password.
#
# The firstboot action feeds it to `chpasswd -e`, which takes its input as an
# already-encrypted field and writes it into /etc/shadow verbatim. Seal the
# plaintext by mistake and the account ends up with a shadow field that no
# password can ever match: not an error, not a warning, just an account nobody
# can log into, found out at a console on a machine that is by then the only
# copy of itself.
#
# Checked in memory, never through a file: this is the one command whose whole
# job is that the plaintext does not touch the disk.
seal_password_check() {
    case $2 in
        '$'*'$'*) return 0 ;;
    esac
    die "secrets/$1 must hold a password *hash*, and this does not look like one.
         It is applied with \`chpasswd -e\`, which writes what it is given
         straight into /etc/shadow — so a plaintext here becomes a field no
         password matches, and the account is locked out with nothing said.
         Make the hash and pipe that instead:
             $SPORE_SELF -s $SPORE_DIR passwd ${1%.password}
         (it asks twice and prints \$6\$...; the password never reaches a file)"
}

# A module setting, set rather than edited into place.
#
# The conf files are the format and stay authoritative — they are meant to be
# read, diffed and committed, and opening one in an editor is not a workaround.
# What this adds is the checking: a module that does not exist, a module that is
# not in MODULES and so reads nothing, a value that does not survive the round
# trip. All three are silent in an editor, and the last one is silent until a
# boot.
cmd_set() {
    [ $# -eq 3 ] || die "usage: spore set MODULE KEY VALUE
         e.g.  spore set net NET_DNS 1.1.1.1"
    spore_load
    cse_mod=$1 cse_key=$2 cse_val=$3
    case $cse_mod in
        ''|*[!A-Za-z0-9_-]*) die "not a module name: '$cse_mod'" ;;
    esac
    case $cse_key in
        ''|*[!A-Za-z0-9_]*) die "not a config key: '$cse_key'" ;;
    esac
    case $cse_val in
        *'
'*) die "a value is one line; this one is not." ;;
    esac

    [ -f "$SPORE_MODULES/$cse_mod.sh" ] ||
        die "no module called '$cse_mod'. \`spore modules\` lists them."
    case " $SPORE_MODULE_LIST " in
        *" $cse_mod "*) : ;;
        *) warn "'$cse_mod' is not in MODULES in spore.conf, so nothing reads
         this. The setting is written; the module stays off until you add it
         there." ;;
    esac

    cse_f=$SPORE_DIR/modules/$cse_mod.conf
    cse_was=$(conf_get "$cse_f" "$cse_key" '')
    if [ "$SPORE_DRYRUN" = 1 ]; then
        say "would set $cse_key=$cse_val in modules/$cse_mod.conf (now: ${cse_was:-unset})"
        return 0
    fi

    mkdir -p "$SPORE_DIR/modules"
    [ -f "$cse_f" ] || : > "$cse_f"
    bootstrap_set "$cse_f" "$cse_key" "\"$cse_val\""

    # Read it back through the same parser the planner uses. A value that needed
    # quoting or tripped the rewrite is otherwise a boot away from being noticed.
    cse_now=$(conf_get "$cse_f" "$cse_key" '')
    [ "$cse_now" = "$cse_val" ] ||
        die "wrote $cse_key into $cse_f, but it reads back as '$cse_now'.
         The file is as it was left — look at it before applying anything."
    if [ -n "$cse_was" ] && [ "$cse_was" != "$cse_val" ]; then
        printf 'modules/%s.conf: %s  %s -> %s\n' "$cse_mod" "$cse_key" "$cse_was" "$cse_val"
    else
        printf 'modules/%s.conf: %s = %s\n' "$cse_mod" "$cse_key" "$cse_val"
    fi
}

cmd_passwd() {
    [ $# -eq 1 ] || die "usage: spore passwd USER   (root, or a name in USERS)"
    spore_load
    # A password sealed under a name nothing applies is a password that silently
    # does not exist. Said now rather than found at a login prompt.
    cp_users=$(conf_get "$SPORE_DIR/modules/users.conf" USERS '' 2>/dev/null || true)
    case " root $cp_users " in
        *" $1 "*) : ;;
        *) warn "'$1' is neither root nor in USERS in modules/users.conf, so no
         account here will be given this password. Add it to USERS, or seal it
         under a name that is already there." ;;
    esac
    secret_seal_password "$1" || exit 1
    printf '\nIt is applied at the next boot that runs the spore. On a machine\n'
    printf 'that already has its overlay:  spore install <dir> <device>\n'
}

cmd_modules() {
    case ${1:-} in
        ''|list) [ $# -le 1 ] || die "usage: spore modules [list | add NAME... | rm NAME...]"
                 cmd_modules_list ;;
        add|rm|remove) cmd_modules_edit "$@" ;;
        *) die "usage: spore modules [list | add NAME... | rm NAME...]" ;;
    esac
}

# MODULES lives in spore.conf, not in a module's own conf, so `spore set` could
# not reach it: everything about a module was settable except whether it ran at
# all. Enabling one meant opening spore.conf and editing a quoted list by hand,
# which is where a typo becomes "that module silently does nothing".
cmd_modules_edit() {
    cme_op=$1
    shift
    [ $# -ge 1 ] || die "usage: spore modules $cme_op NAME..."
    spore_load
    cme_list=$SPORE_MODULE_LIST
    for cme_n in "$@"; do
        case $cme_n in
            ''|*[!A-Za-z0-9_-]*) die "not a module name: '$cme_n'" ;;
        esac
        case " $cme_list " in
            *" $cme_n "*) cme_on=yes ;;
            *) cme_on=no ;;
        esac
        if [ "$cme_op" = add ]; then
            [ -f "$SPORE_MODULES/$cme_n.sh" ] ||
                die "no module called '$cme_n'. \`spore modules\` lists them."
            [ "$cme_on" = no ] || { say "$cme_n is already enabled"; continue; }
            cme_list="$cme_list $cme_n"
        else
            [ "$cme_on" = yes ] || { say "$cme_n is not enabled"; continue; }
            cme_keep=''
            for cme_x in $cme_list; do
                [ "$cme_x" = "$cme_n" ] && continue
                cme_keep="$cme_keep $cme_x"
            done
            cme_list=$cme_keep
        fi
    done

    # Rebuilt word by word, so whatever spacing the file had comes out normal.
    cme_new=''
    for cme_x in $cme_list; do cme_new="$cme_new $cme_x"; done
    cme_new=${cme_new# }
    [ -n "$cme_new" ] ||
        die "that would leave MODULES empty, and a spore with no modules plans
         nothing at all. Remove the spore instead, if that is what you mean."
    if [ "$cme_new" = "$SPORE_MODULE_LIST" ]; then
        printf 'spore.conf: MODULES = %s (unchanged)\n' "$cme_new"
        return 0
    fi
    if [ "$SPORE_DRYRUN" = 1 ]; then
        say "would set MODULES=\"$cme_new\" in spore.conf"
        return 0
    fi
    bootstrap_set "$SPORE_DIR/spore.conf" MODULES "\"$cme_new\""
    cme_back=$(conf_get "$SPORE_DIR/spore.conf" MODULES '')
    [ "$cme_back" = "$cme_new" ] ||
        die "wrote MODULES into spore.conf, but it reads back as '$cme_back'."
    printf 'spore.conf: MODULES = %s\n' "$cme_new"
    if [ "$cme_op" = add ] && [ ! -f "$SPORE_DIR/modules/$1.conf" ]; then
        say "there is no modules/$1.conf, so it runs on its defaults.
         \`spore plan\` shows what those come to; \`spore set $1 KEY VALUE\`
         changes them."
    fi
}

cmd_modules_list() {
    for cm_m in $(module_available); do
        SPORE_DIR=${SPORE_DIR:-/nonexistent}
        module_load "$cm_m"
        SPORE_MOD=$cm_m
        MOD_DESC='' MOD_REQUIRES=''
        "${cm_m}_meta" 2>/dev/null || true
        printf '  %-10s %s%s\n' "$cm_m" "$MOD_DESC" \
            "$([ -n "$MOD_REQUIRES" ] && printf '  [needs: %s]' "$MOD_REQUIRES")"
    done
}

cmd_init() {
    ci_dir=${1:-./spore}
    [ ! -e "$ci_dir" ] || die "$ci_dir already exists"
    mkdir -p "$ci_dir/modules" "$ci_dir/files" "$ci_dir/secrets"
    cat > "$ci_dir/spore.conf" <<'INIT'
FORMAT=1
HOST=changeme
MODULES="ssh net"
# Where the age private key lives on the host. Never inside the spore.
SECRETS_IDENTITY=/etc/spore/identity
INIT
    cat > "$ci_dir/modules/ssh.conf" <<'INIT'
SSH_ENABLED=yes
SSH_PORT=22
SSH_PERMIT_ROOT_LOGIN=prohibit-password
SSH_PASSWORD_AUTH=no
INIT
    cat > "$ci_dir/modules/net.conf" <<'INIT'
NET_HOSTNAME=changeme
NET_IFACE=eth0
NET_MODE=dhcp
INIT
    : > "$ci_dir/packages"
    : > "$ci_dir/blobs.conf"
    printf 'created %s\n' "$ci_dir"
}

cmd_new() {
    [ $# -ge 1 ] || die "usage: spore new NAME [DIR]"
    new_machine "$@"
}

cmd_install() {
    [ $# -ge 2 ] && [ $# -le 3 ] || die "usage: spore install DIR DATA [BOOT]"
    spore_workspace
    install_machine "$@"
}

cmd_retire() {
    [ $# -ge 1 ] && [ $# -le 2 ] ||
        die "usage: spore retire DEVICE   (or: spore retire DATADIR [BOOTDIR])"
    spore_workspace
    if [ -b "$1" ]; then
        [ $# -eq 1 ] ||
            die "when the target is a device both partitions are found on it,
        so there is no second argument to give."
        retire_medium "$1"
    else
        [ -d "$1" ] || die "no such device or directory: $1"
        retire_seeds "$@"
    fi
}

cmd_setup() {
    spore_workspace
    wizard "$@"
}

cmd_try() {
    [ $# -ge 1 ] ||
        die "usage: spore try DEVICE|IMAGE [write] [bootloader] [disk|disk=PATH] [mem=MB]"
    spore_workspace
    try_boot "$@"
}

cmd_inspect() {
    [ $# -eq 1 ] || die "usage: spore inspect DEVICE|DIRECTORY"
    spore_workspace
    inspect_medium "$1"
}

cmd_media() {
    [ $# -eq 2 ] || die "usage: spore media /dev/sdX alpine-standard-*.iso"
    spore_workspace
    media_write "$@"
}

# A word this command has no use for is a mistake worth naming: it is almost
# always a misspelled option, and the alternative is doing three-quarters of
# what was asked and reporting success.
cmd_noargs() {
    [ $# -eq 0 ] || die "spore $SPORE_CMD takes no arguments, but got: $*"
}

case $SPORE_CMD in
    setup)   cmd_setup "$@" ;;
    media)   cmd_media "$@" ;;
    try)     cmd_try "$@" ;;
    inspect) cmd_inspect "$@" ;;
    new)     cmd_new "$@" ;;
    install) cmd_install "$@" ;;
    retire)  cmd_retire "$@" ;;
    init)    cmd_init "$@" ;;
    plan)    cmd_noargs "$@"; cmd_plan ;;
    apply)   cmd_noargs "$@"; cmd_apply ;;
    status)  cmd_noargs "$@"; cmd_status ;;
    diff)    cmd_noargs "$@"; cmd_diff ;;
    persist) cmd_noargs "$@"; cmd_persist ;;
    doctor)  cmd_noargs "$@"; cmd_doctor ;;
    modules|module) cmd_modules "$@" ;;
    secrets) cmd_noargs "$@"; cmd_secrets ;;
    seed)    cmd_seed "$@" ;;
    seal)    cmd_seal "$@" ;;
    passwd)  cmd_passwd "$@" ;;
    set)     cmd_set "$@" ;;
    help)    usage ;;
    *)       die "unknown command: $SPORE_CMD (try: spore --help)" ;;
esac
